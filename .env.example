# Variables para docker-compose — copia este archivo a `.env` en el VPS
POSTGRES_USER=sst
POSTGRES_PASSWORD=cambia_este_password
POSTGRES_DB=sst

APP_PORT=3000

# Dominio (opcional). Déjalo comentado para servir por IP en puerto 80.
# Cuando tengas dominio apuntando al VPS, descoméntalo y reinicia: docker compose up -d
# CADDY_DOMAIN=midominio.com

# Lovable Cloud / Supabase (opcional, si tu app los usa)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
